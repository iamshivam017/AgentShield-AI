# API
ENVIRONMENT=development
DATABASE_URL=sqlite:///./agentshield.db
JWT_SECRET=replace-with-at-least-32-random-characters
DEMO_USER_PASSWORD=choose-a-local-demo-password
ACCESS_TOKEN_TTL_MINUTES=30
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Optional LLM explanation provider. Deterministic explanations are the default.
LLM_PROVIDER=deterministic
OPENAI_API_KEY=

# Razorpay test mode only. Never commit real values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_TEST_MODE=true

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
